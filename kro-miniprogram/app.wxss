/* 全局：手绘奇幻暗色主题 */
page {
    min-height: 100%;
    background: #1a1208;
    color: #f3e6c8;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
    border-radius: 12rpx;
}

/* 通用：金色描边标题 */
.kro-title {
    color: #f5d67a;
    font-weight: 700;
    text-shadow: 0 2rpx 0 #6b4a12, 0 0 18rpx rgba(245, 214, 122, 0.25);
}

/* 通用：羊皮纸卡片 */
.parchment {
    background: linear-gradient(160deg, #f0e2bd 0%, #d9c08a 100%);
    color: #3a2a12;
    border: 3rpx solid #8a6a34;
    border-radius: 20rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.4), inset 0 0 30rpx rgba(138, 106, 52, 0.25);
}

/* 通用：木质按钮 */
.wood-btn {
    background: linear-gradient(180deg, #7a5228 0%, #4e3317 100%);
    color: #f5e4bf;
    border: 2rpx solid #a9793f;
    border-radius: 16rpx;
    font-weight: 600;
    box-shadow: 0 6rpx 0 #2e1c0a, 0 8rpx 16rpx rgba(0, 0, 0, 0.45);
}
.wood-btn::after { border: none; }
.wood-btn:active { transform: translateY(4rpx); box-shadow: 0 2rpx 0 #2e1c0a; }
