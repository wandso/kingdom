.levels-page {
    min-height: 100vh;
    padding: 28rpx 24rpx 60rpx;
    box-sizing: border-box;
    background:
        radial-gradient(circle at 20% 0%, rgba(120,160,90,0.15), transparent 45%),
        linear-gradient(180deg, #202c18 0%, #161008 100%);
}
.map-head { display: flex; flex-direction: column; align-items: center; margin-bottom: 24rpx; }
.map-title { font-size: 40rpx; }
.map-sub { margin-top: 8rpx; font-size: 22rpx; color: #b7c79a; }

.difficulty-bar { display: flex; align-items: center; margin-bottom: 28rpx; }
.diff-label { font-size: 24rpx; color: #d8c187; margin-right: 16rpx; }
.diff-pills { display: flex; flex: 1; gap: 10rpx; }
.diff-pill {
    flex: 1; text-align: center; padding: 12rpx 0;
    font-size: 22rpx; color: #c8b78e;
    background: #2e2210; border: 2rpx solid #6b5228; border-radius: 12rpx;
}
.diff-pill.active { color: #2b1d0e; background: linear-gradient(180deg,#f5d67a,#c99a3f); border-color: #f7e6a8; font-weight: 700; }

.level-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.level-node {
    position: relative;
    width: calc(25% - 14rpx);
    box-sizing: border-box;
    padding: 18rpx 8rpx 14rpx;
    display: flex; flex-direction: column; align-items: center;
    background: linear-gradient(160deg, #f0e2bd, #d9c08a);
    border: 3rpx solid #8a6a34; border-radius: 18rpx;
    box-shadow: 0 6rpx 14rpx rgba(0,0,0,0.35);
}
.level-node.locked { background: linear-gradient(160deg, #4a4030, #332b1c); border-color: #5a4a30; opacity: 0.75; }
.node-badge {
    width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
    font-size: 30rpx; font-weight: 700; color: #f5e4bf;
    background: linear-gradient(180deg,#7a5228,#4e3317);
    border: 2rpx solid #a9793f; border-radius: 50%;
}
.node-name { margin-top: 12rpx; font-size: 20rpx; font-weight: 600; text-align: center; color: #3a2a12; line-height: 1.25; }
.level-node.locked .node-name { color: #a89878; }
.node-stars { margin-top: 6rpx; }
.star { font-size: 20rpx; color: #9a8558; }
.star.on { color: #e8a92a; }
.node-boss { margin-top: 4rpx; font-size: 18rpx; color: #b34a3a; font-weight: 700; }

.legend { margin-top: 32rpx; text-align: center; font-size: 22rpx; color: #9a8a68; }
