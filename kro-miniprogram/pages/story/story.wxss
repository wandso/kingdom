.story-page { min-height: 100vh; padding: 28rpx 24rpx 60rpx; box-sizing: border-box; background: linear-gradient(180deg,#241c10,#160f08); }
.page-head { display: flex; flex-direction: column; align-items: center; margin-bottom: 22rpx; }
.page-title { font-size: 42rpx; }
.page-sub { margin-top: 8rpx; font-size: 22rpx; color: #c0ac82; }

.chapter-tabs { display: flex; gap: 10rpx; margin-bottom: 24rpx; }
.chapter-tab {
    flex: 1; height: 60rpx; line-height: 60rpx; text-align: center;
    font-size: 28rpx; font-weight: 700; color: #d8c187;
    background: #2e2210; border: 2rpx solid #6b5228; border-radius: 12rpx;
}
.chapter-tab.active { color: #2b1d0e; background: linear-gradient(180deg,#f5d67a,#c99a3f); border-color: #f7e6a8; }

.comic-card { padding: 28rpx; }
.comic-head { display: flex; align-items: baseline; gap: 16rpx; }
.comic-chapter { font-size: 24rpx; color: #8a6a34; font-weight: 700; }
.comic-title { font-size: 34rpx; font-weight: 700; color: #3a2a12; }
.comic-scene {
    margin: 22rpx 0; height: 220rpx;
    display: flex; align-items: center; justify-content: center;
    background: radial-gradient(circle at 50% 40%, #6a7f4a, #2f3a1e);
    border: 3rpx solid #8a6a34; border-radius: 16rpx;
    box-shadow: inset 0 0 40rpx rgba(0,0,0,0.4);
}
.scene-glyph { font-size: 140rpx; font-weight: 700; color: rgba(245,214,122,0.35); text-shadow: 0 6rpx 20rpx rgba(0,0,0,0.5); }

.dialogue-list { display: flex; flex-direction: column; gap: 18rpx; }
.dialogue { display: flex; flex-direction: column; padding: 18rpx; background: rgba(255,255,255,0.35); border-left: 6rpx solid #c99a3f; border-radius: 8rpx; }
.speaker { font-size: 22rpx; font-weight: 700; color: #8a5a12; }
.line-text { margin-top: 8rpx; font-size: 28rpx; line-height: 1.7; color: #3a2a12; }

.comic-nav { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding-top: 20rpx; border-top: 2rpx solid #b39a5e; }
.nav-btn { padding: 14rpx 22rpx; font-size: 26rpx; font-weight: 600; color: #f5e4bf; background: #6b4a22; border-radius: 12rpx; }
.nav-count { font-size: 24rpx; color: #6b4a12; }

.ach-block { margin-top: 32rpx; }
.ach-head { display: flex; justify-content: space-between; padding: 20rpx; font-size: 26rpx; font-weight: 600; color: #f5d67a; background: #2e2210; border: 2rpx solid #6b5228; border-radius: 14rpx; }
.ach-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.ach-item { padding: 12rpx 16rpx; font-size: 22rpx; color: #c8b78e; background: #241a0c; border: 2rpx solid #5a4522; border-radius: 10rpx; }
