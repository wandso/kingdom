.heroes-page { min-height: 100vh; padding: 28rpx 24rpx 60rpx; box-sizing: border-box; background: linear-gradient(180deg,#202c18,#161008); }
.page-head { display: flex; flex-direction: column; align-items: center; margin-bottom: 24rpx; }
.page-title { font-size: 42rpx; }
.page-sub { margin-top: 8rpx; font-size: 22rpx; color: #b7c79a; }

.hero-strip { white-space: nowrap; margin-bottom: 28rpx; }
.hero-chip {
    display: inline-flex; flex-direction: column; align-items: center;
    width: 128rpx; margin-right: 16rpx;
}
.chip-face {
    width: 96rpx; height: 96rpx; line-height: 96rpx; text-align: center;
    font-size: 40rpx; font-weight: 700; color: #fff;
    border: 3rpx solid #c9a24a; border-radius: 50%;
    box-shadow: 0 6rpx 14rpx rgba(0,0,0,0.4);
}
.hero-chip.active .chip-face { border-color: #f5d67a; box-shadow: 0 0 20rpx rgba(245,214,122,0.6); }
.hero-chip.locked .chip-face { filter: grayscale(1); opacity: 0.6; }
.chip-name { margin-top: 10rpx; font-size: 22rpx; color: #d8c187; text-align: center; }

.hero-detail { padding: 32rpx; }
.detail-head { display: flex; align-items: center; }
.detail-avatar {
    width: 120rpx; height: 120rpx; line-height: 120rpx; text-align: center;
    font-size: 56rpx; font-weight: 700; color: #fff;
    border: 4rpx solid #8a6a34; border-radius: 50%;
}
.detail-id { display: flex; flex-direction: column; margin-left: 24rpx; }
.detail-name { font-size: 40rpx; font-weight: 700; color: #3a2a12; }
.detail-en { margin-top: 6rpx; font-size: 22rpx; color: #7a5f2e; }
.detail-lock { margin-top: 8rpx; font-size: 22rpx; color: #b34a3a; }
.detail-desc { display: block; margin: 24rpx 0; font-size: 26rpx; line-height: 1.7; color: #5a4522; }
.section-h { display: block; font-size: 26rpx; font-weight: 700; color: #6b4a12; border-bottom: 2rpx solid #b39a5e; padding-bottom: 10rpx; }

.skill-card { display: flex; align-items: flex-start; margin-top: 18rpx; }
.skill-badge {
    width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; flex-shrink: 0;
    font-size: 24rpx; font-weight: 700; color: #f5e4bf;
    background: #6b4a22; border-radius: 50%;
}
.skill-body { display: flex; flex-direction: column; margin-left: 16rpx; }
.skill-n { font-size: 28rpx; font-weight: 700; color: #3a2a12; }
.skill-en { font-size: 20rpx; color: #8a6a34; font-style: italic; }
.skill-d { margin-top: 6rpx; font-size: 24rpx; line-height: 1.6; color: #5a4522; }
