.wechat-login {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 56rpx 40rpx;
    background: linear-gradient(160deg, #2e2210 0%, #1a1208 100%);
    border: 3rpx solid #8a6a34;
    border-radius: 28rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.5);
}
.crest {
    width: 110rpx;
    height: 110rpx;
    line-height: 110rpx;
    text-align: center;
    font-size: 60rpx;
    color: #2b1d0e;
    background: radial-gradient(circle at 35% 30%, #f7e6a8, #c99a3f);
    border: 4rpx solid #f5d67a;
    border-radius: 50%;
    box-shadow: 0 0 30rpx rgba(245, 214, 122, 0.4);
}
.login-title {
    margin-top: 28rpx;
    font-size: 40rpx;
    font-weight: 700;
    color: #f5d67a;
}
.login-desc {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #c8b78e;
}
.login-btn {
    margin-top: 40rpx;
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 30rpx;
    font-weight: 700;
    color: #2b1d0e;
    background: linear-gradient(180deg, #f5d67a, #c99a3f);
    border: 2rpx solid #f7e6a8;
    border-radius: 18rpx;
}
.login-btn::after { border: none; }
.login-error {
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #ff9b8a;
}
